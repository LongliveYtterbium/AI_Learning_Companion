<view class="page"><text class="eyebrow">针对性练习</text><text class="title">用同一种方法，再做一题。</text><text class="copy">题目会根据你刚才解答的知识点自动生成。</text><view wx:if="{{loading}}" class="thinking-card"><view class="spinner"></view><text class="thinking-title">AI 正在出题</text><text class="thinking-copy">{{status}}</text><text class="thinking-time">已用时 {{elapsed}} 秒</text></view><view wx:elif="{{error}}" class="card"><text class="card-title">暂时无法生成练习</text><text class="card-copy">{{error}}</text><button class="secondary" bindtap="home">返回首页</button></view><block wx:else><view class="card"><text class="label">变式练习</text><rich-text class="card-title math-rich" nodes="{{practice.questionNodes}}"/><text class="card-copy">{{practice.knowledgeText}}</text></view><view class="card"><text class="label">提示</text><rich-text class="card-copy math-rich" nodes="{{practice.hintNodes}}"/></view><view wx:if="{{!result}}"><input class="input" placeholder="写下你的答案" value="{{answer}}" bindinput="input"/><button class="primary" loading="{{checking}}" disabled="{{checking}}" bindtap="submit">{{checking ? 'AI 正在判题…' : '提交并查看结果'}}</button></view><view wx:else class="card {{result.correct ? 'result' : ''}}"><text class="card-title">{{result.correct ? '✓ 做对了，思路已经掌握！' : '再回顾一下关键步骤'}}</text><rich-text class="card-copy math-rich" nodes="{{result.feedbackNodes}}"/><text class="label">标准答案</text><rich-text class="card-copy math-rich" nodes="{{result.idealAnswerNodes}}"/><button wx:if="{{result.correct}}" class="secondary" bindtap="home">记录学习成果</button><button wx:else class="secondary" bindtap="retry">再试一次</button></view></block></view>
