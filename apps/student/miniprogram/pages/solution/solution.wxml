<view class="page" wx:if="{{result}}"><view class="card"><text class="label">题目</text><rich-text class="card-title math-rich" nodes="{{result.problemNodes}}"/><text class="card-copy">{{result.subject}} · {{result.knowledgeText}}</text></view><view class="tabs"><text class="tab {{tab==='answer'?'active':''}}" data-tab="answer" bindtap="tab">答案</text><text class="tab {{tab==='analysis'?'active':''}}" data-tab="analysis" bindtap="tab">逐步解析</text><text class="tab {{tab==='tip'?'active':''}}" data-tab="tip" bindtap="tab">易错点</text></view><view wx:if="{{tab==='answer'}}" class="card"><text class="label">最终答案</text><rich-text class="answer-math math-rich" nodes="{{result.answerNodes}}"/></view><view wx:if="{{tab==='analysis'}}"><view class="step" wx:for="{{result.steps}}" wx:key="index"><text class="step-name">{{index + 1}}. {{item.title}}</text><rich-text class="card-copy math-rich" nodes="{{item.contentNodes}}"/></view></view><view wx:if="{{tab==='tip'}}" class="card"><text class="card-title">易错点</text><rich-text class="card-copy math-rich" nodes="{{result.mistakeNodes}}"/></view><button class="primary" bindtap="practice">我想再练一道</button></view><view class="page" wx:else><text class="title">暂无解题结果</text><text class="copy">请从首页拍题并开始 AI 解题。</text></view>
