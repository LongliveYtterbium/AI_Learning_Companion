# 应用运行环境：development、test 或 production
NODE_ENV=development

# 本地后端服务
API_PORT=3000
API_BASE_URL=http://localhost:3000

# 本地 PostgreSQL（Docker 启动后使用）
DATABASE_URL=postgresql://ai_learning:change_me@localhost:5432/ai_learning?schema=public
POSTGRES_DB=ai_learning
POSTGRES_USER=ai_learning
POSTGRES_PASSWORD=change_me

# 本地开发期图片存储目录；上线后改为对象存储配置
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./data/uploads

# 仅由后端读取；不得写入小程序代码或提交到 Git
AI_API_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
